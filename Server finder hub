-- Buscador mediante API publica de Roblox
local function fetchServers()
    clearList()
    status.Text = "Consultando servidores..."

    -- Los ejecutores externos pueden exponer funciones HTTP.
    local req

    if syn and syn.request then
        req = syn.request
    elseif http and http.request then
        req = http.request
    elseif request then
        req = request
    end

    if not req then
        status.Text =
            "No hay una funcion HTTP compatible en este entorno."
        return
    end

    local url = "https://games.roblox.com/v1/games/"
        .. PLACE_ID
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local ok, response = pcall(function()
        return req({
            Url = url,
            Method = "GET"
        })
    end)

    if not ok or not response
        or (response.StatusCode and response.StatusCode ~= 200)
        or not response.Body then

        status.Text = "Error consultando la API publica de Roblox."
        return
    end

    local decodedOk, data = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedOk or type(data.data) ~= "table" then
        status.Text = "Respuesta no valida de la API."
        return
    end

    table.sort(data.data, function(a, b)
        return (a.playing or 0) < (b.playing or 0)
    end)

    local count = 0

    for _, server in ipairs(data.data) do
        if (server.playing or 0) < (server.maxPlayers or 0) then
            count += 1
            addServer(server, count)
        end
    end

    status.Text = tostring(count) .. " servidores disponibles."
end

