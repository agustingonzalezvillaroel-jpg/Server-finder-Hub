
-- SERVER FINDER HUB - INTEGRACION VISUAL
-- Boton: 107486661308693
-- Fondo: 115849690020203

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local guiParent = (gethui and gethui())
    or player:WaitForChild("PlayerGui")

-- Limpiar interfaz anterior
local old = guiParent:FindFirstChild("SFCustomControls")
if old then
    old:Destroy()
end

-- Cargar el buscador original
task.spawn(function()
    local ok, err = pcall(function()
        loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/agustingonzalezvillaroel-jpg/Server-finder/main/Server%20finder"
        ))()
    end)

    if not ok then
        warn("Error cargando Server Finder:", err)
    end
end)

-- Esperar la interfaz original
local originalGui
local main

for i = 1, 100 do
    originalGui = player.PlayerGui:FindFirstChild("ServerFinder")
    if originalGui then
        main = originalGui:FindFirstChild("Main")
        if main then break end
    end
    task.wait(0.1)
end

if not main then
    warn("No se encontro el panel original de Server Finder.")
    return
end

-- Ocultar el boton de restaurar original
local restore = originalGui:FindFirstChild("TextButton")
if restore and restore.Name == "restore" then
    restore.Visible = false
end

-- Aplicar imagen de fondo al panel original
local bg = Instance.new("ImageLabel")
bg.Name = "CustomPanelBackground"
bg.Size = UDim2.fromScale(1, 1)
bg.Position = UDim2.fromScale(0, 0)
bg.BackgroundTransparency = 1
bg.Image = "rbxassetid://115849690020203"
bg.ScaleType = Enum.ScaleType.Crop
bg.ZIndex = 0
bg.Parent = main

-- Mantener controles encima del fondo
for _, obj in ipairs(main:GetDescendants()) do
    if obj:IsA("GuiObject") and obj ~= bg then
        obj.ZIndex = math.max(obj.ZIndex, 1)
    end
end

-- Crear interfaz del boton
local gui = Instance.new("ScreenGui")
gui.Name = "SFCustomControls"
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000
gui.Parent = guiParent

local button = Instance.new("ImageButton")
button.Name = "OpenButton"
button.Size = UDim2.fromOffset(76, 76)
button.Position = UDim2.new(0, 22, 0.4, 0)
button.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
button.Image = "rbxassetid://107486661308693"
button.ScaleType = Enum.ScaleType.Crop
button.Active = true
button.Parent = gui

Instance.new("UICorner", button).CornerRadius = UDim.new(1, 0)

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(0, 190, 255)
stroke.Thickness = 2
stroke.Parent = button

-- Arrastrar con el dedo o el mouse
local dragging = false
local moved = false
local startPos
local startButtonPos
local activeTouch

button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        moved = false
        startPos = input.Position
        startButtonPos = button.Position

        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end

    local isMouse = input.UserInputType ==
        Enum.UserInputType.MouseMovement
    local isTouch = input == activeTouch

    if isMouse or isTouch then
        local delta = input.Position - startPos

        if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then
            moved = true
        end

        button.Position = UDim2.new(
            startButtonPos.X.Scale,
            startButtonPos.X.Offset + delta.X,
            startButtonPos.Y.Scale,
            startButtonPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        activeTouch = nil
    end
end)

-- Abrir y cerrar el panel original
button.Activated:Connect(function()
    if moved then
        moved = false
        return
    end

    main.Visible = not main.Visible
end)
