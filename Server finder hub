-- Boton arrastrable: mouse y pantalla tactil
local dragging = false
local moved = false
local dragStart
local buttonStart
local activeTouch

restore.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        moved = false
        dragStart = input.Position
        buttonStart = restore.Position

        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    local isMouseMove =
        input.UserInputType == Enum.UserInputType.MouseMovement

    local isActiveTouch = input == activeTouch

    if isMouseMove or isActiveTouch then
        local delta = input.Position - dragStart

        if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then
            moved = true
        end

        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize

        local x = buttonStart.X.Offset + delta.X
        local y = buttonStart.Y.Offset + delta.Y

        if viewport then
            x = math.clamp(
                x,
                0,
                viewport.X - restore.AbsoluteSize.X
            )

            y = math.clamp(
                y,
                0,
                viewport.Y - restore.AbsoluteSize.Y
            )
        end

        restore.Position = UDim2.new(
            buttonStart.X.Scale,
            x,
            buttonStart.Y.Scale,
            y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = false
        activeTouch = nil
    end
end)

-- Restaurar el panel al tocar el boton flotante
restore.Activated:Connect(function()
    if moved then
        moved = false
        return
    end

    restore.Visible = false
    main.Visible = true
end)
